[configuration]
entry_symbol = "flowfield_library_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64 = "res://addons/flowfields/bin/libflowfield.so"
linux.release.x86_64 = "res://addons/flowfields/bin/libflowfield.so"
windows.debug.x86_64 = "res://addons/flowfields/bin/libflowfield.dll"
windows.release.x86_64 = "res://addons/flowfields/bin/libflowfield.dll"
android.debug.arm64 = "res://addons/flowfields/bin/libflowfield.android.debug.arm64.so"
android.release.arm64 = "res://addons/flowfields/bin/libflowfield.android.release.arm64.so"
