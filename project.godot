; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Poly Guard 2D"
run/main_scene="uid://cslsestkvwjl2"
config/features=PackedStringArray("4.6", "Mobile")
run/max_fps=240
config/icon="res://icon.svg"

[autoload]

GameManager="*uid://bh6gjdf6wjx87"
Registry="*uid://btdmff6ur7gu2"
SignalBus="*uid://f4x1spochkwu"
AudioManager="*uid://dns2dtsx4xm5b"
SaveManager="*uid://c36ci1uxro7aq"
SettingsManager="*uid://ce1684yjgnm6d"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://src/autoload/": "green",
"res://src/components/": "red",
"res://src/data/": "gray",
"res://src/scenes/": "blue",
"res://src/scenes/towers/": "yellow",
"res://src/scenes/ui/": "teal",
"res://vendor/": "orange"
}

[gui]

theme/custom="uid://fcjpxmjswpwu"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
