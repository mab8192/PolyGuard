[sub_resource type="Resource" id="Resource_choice_serrated"]
script = ExtResource("1_choice")
id = "serrated_spikes"
title = "Serrated Spikes"
description = "Deep lacerating spike barbs that deal +40% increased physical burst damage."
strength_multiplier = 1.4
icon = ExtResource("ext_var_serrated_spikes")

[sub_resource type="Resource" id="Resource_choice_recoil"]
script = ExtResource("1_choice")
id = "hydraulic_spring"
