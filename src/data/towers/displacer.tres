[sub_resource type="Resource" id="Resource_choice_warp"]
script = ExtResource("1_choice")
id = "warp_amplifier"
title = "Warp Amplifier"
description = "High-energy resonant coils reducing trigger cooldown by 25%."
cooldown_multiplier = 0.75
icon = ExtResource("ext_var_warp_amplifier")

[sub_resource type="Resource" id="Resource_choice_mass"]
