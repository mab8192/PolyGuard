description = "Non-solid trap that teleports passing enemies backwards along their path."
unlock_cost = 800
required_stage_id = "stage_11"
choices = Array[ExtResource("1_choice")]([SubResource("Resource_choice_warp"), SubResource("Resource_choice_mass")])
