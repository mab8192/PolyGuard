[sub_resource type="Resource" id="Resource_choice_permafrost"]
script = ExtResource("1_choice")
id = "permafrost_seal"
title = "Permafrost Coating"
description = "Supercooled cryo matrix that reduces trap construction and upgrade energy costs."
cooldown_multiplier = 0.8

[sub_resource type="Resource" id="Resource_choice_glaze"]
script = ExtResource("1_choice")
id = "sub_zero_glaze"
title = "Sub-Zero Glaze"
description = "Extremely low friction glaze increasing target slide instability."
