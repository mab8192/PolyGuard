description = "Non-solid cryo plate that reduces enemy acceleration, making them slide and drift uncontrollably."
unlock_cost = 650
choices = Array[ExtResource("1_choice")]([SubResource("Resource_choice_permafrost"), SubResource("Resource_choice_glaze")])
