[sub_resource type="Resource" id="Resource_choice_tempest"]
script = ExtResource("1_choice")
id = "hurricane_force"
title = "Hurricane Force"
description = "Supercharged gale turbines increase burst impulse force by +50% with +25% structure durability."
strength_multiplier = 1.5
health_multiplier = 1.25
icon = ExtResource("ext_var_hurricane_force")

[sub_resource type="Resource" id="Resource_choice_vortex"]
script = ExtResource("1_choice")
id = "gale_vortex"
title = "Gale Vortex"
description = "High-velocity vortex conduits increase impulse force by +25% and reduce burst cooldown by 25%."
strength_multiplier = 1.25
cooldown_multiplier = 0.75
icon = ExtResource("ext_var_gale_vortex")

[sub_resource type="Resource" id="Resource_wind_force"]
script = ExtResource("2_effect")
name = "Aerodynamic Wind Thrust"
duration = 2.0
speed_multiplier = 0.8
impulse_force = 400.0

[sub_resource type="Resource" id="Resource_applier_data"]
script = ExtResource("4_applier")
mode = 2
delay = 0.3
active_duration = 2.0
cooldown = 5.0
effects = Array[ExtResource("2_effect")]([SubResource("Resource_wind_force")])
metadata/_custom_type_script = "uid://b6m2boucd8dke"

[resource]
script = ExtResource("7_tower")
tower_id = "wind_wall"
display_name = "Wind Wall"
icon = ExtResource("5_icon")
scene = ExtResource("6_scene")
description = "Directional aerodynamic barrier that generates high-velocity wind currents, physically pushing physical enemies backward in the facing direction."
unlock_cost = 500
required_stage_id = "stage_09"
choices = Array[ExtResource("1_choice")]([SubResource("Resource_choice_tempest"), SubResource("Resource_choice_vortex")])
cost = 300
requires_wall_behind = true
collision_layer = 0
effect_applier = SubResource("Resource_applier_data")
