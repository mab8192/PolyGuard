[sub_resource type="Resource" id="Resource_choice_quick"]
script = ExtResource("1_choice")
id = "rapid_dispersion"
title = "Rapid Dispersion"
description = "Quickened chemical charge delivering 20% faster trap trigger cycle."
cooldown_multiplier = 0.8

[sub_resource type="Resource" id="Resource_choice_cloud"]
script = ExtResource("1_choice")
id = "broad_plume"
title = "Broad Plume"
description = "Expanded toxin cloud catching +3 additional enemies per eruption."
extra_targets = 3

[sub_resource type="Resource" id="Resource_gconv"]
