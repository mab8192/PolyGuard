[resource]
script = ExtResource("3_towerdata")
tower_id = "poison_trap"
display_name = "Poison Trap"
icon = ExtResource("1_icon")
scene = ExtResource("2_scene")
description = "Non-solid trap that triggers after a short delay to poison all enemies in range"
unlock_cost = 350
choices = Array[ExtResource("1_choice")]([SubResource("Resource_choice_quick"), SubResource("Resource_choice_cloud")])
cost = 200
can_rotate = false
collision_layer = 0
effect_applier = SubResource("Resource_gconv")
